show databases;
create table account (     accountid  int auto_increment         primary key,     permission int                                 not null,     ctime      timestamp default CURRENT_TIMESTAMP not null,     mtime      timestamp default CURRENT_TIMESTAMP not null on update CURRENT_TIMESTAMP,     openid     varchar(128)                        not null,     openkey    varchar(128)                        not null,     tunnelid   int       default 0                 null,     info       blob                                null,     constraint openid         unique (openid) );
create table bind (     uid       bigint not null         primary key,     accountid int    not null,     zoneid    int    not null,     serverid  int    null );
create index accountid     on bind (accountid);
create table `order` (     id            bigint unsigned                     not null         primary key,     roleid        bigint                              not null,     status        int                                 not null,     cpsdkorderid  bigint                              null,     pubid         bigint                              not null,     tunnelid      bigint                              not null,     extension     varchar(512)                        null,     productid     varchar(128)                        not null,     productnum    int                                 not null,     orderamount   bigint                              not null,     currency      varchar(5)                          not null,     serverid      int                                 not null,     gamenotifyurl varchar(128)                        not null,     notifytime    timestamp default CURRENT_TIMESTAMP not null on update CURRENT_TIMESTAMP,     ctime         timestamp default CURRENT_TIMESTAMP not null,     mtime         timestamp default CURRENT_TIMESTAMP not null on update CURRENT_TIMESTAMP );
create index cpsdkorderid     on `order` (cpsdkorderid);
create index roleid     on `order` (roleid);
create table server (     uid  int      not null         primary key,     data longblob null comment '服务器逻辑和场景数据' );
create table user (     uid       bigint                                  not null         primary key,     accountid bigint                                  not null,     openid    varchar(128)                            not null,     zoneid    int                                     not null,     serverid  int                                     null,     ctime     timestamp default CURRENT_TIMESTAMP     not null on update CURRENT_TIMESTAMP,     offtime   timestamp default '0000-00-00 00:00:00' not null,     mtime     timestamp default CURRENT_TIMESTAMP     not null on update CURRENT_TIMESTAMP,     data      longblob                                null comment '用户逻辑和场景数据' );
create schema gforge collate utf8mb4_bin;
create database gforge collate utf8mb4_bin;
create schema gforge collate utf8mb4_bin;
use gforge ;
create schema gforge collate utf8mb4_bin;
create table user (     uid       bigint                                  not null         primary key,     accountid bigint                                  not null,     openid    varchar(128)                            not null,     zoneid    int                                     not null,     serverid  int                                     null,     ctime     timestamp default CURRENT_TIMESTAMP     not null on update CURRENT_TIMESTAMP,     offtime   timestamp default '0000-00-00 00:00:00' not null,     mtime     timestamp default CURRENT_TIMESTAMP     not null on update CURRENT_TIMESTAMP,     data      longblob                                null comment '用户逻辑和场景数据' );
;
show databases;
use gforge ;
show tables ;
select * from user;
