<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="winboot.exe"
        Arguments=""
        InstallLocation="C:\Program Files\字节\winboot">
    </Installer>
    <PackageInformation
        PackageName="winboot"
        PackageDisplayName="winboot"
        PublisherName="CN=字节"
        PublisherDisplayName="字节"
        Version="0.0.1.0"
        PackageDescription="支持环境的自动安装、卸载以及服务端进程的维护">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="sw.winboot"
                Description="支持环境的自动安装、卸载以及服务端进程的维护"
                DisplayName="winboot"
                ExecutableName="winboot.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>winboot</DisplayName>
            <PublisherDisplayName>字节</PublisherDisplayName>
            <Description>支持环境的自动安装、卸载以及服务端进程的维护</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="winboot.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
