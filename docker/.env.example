# 配表影响分析环境变量配置
# 复制为 .env 并填入实际值
#
# 适用范围说明：
#   本模板为「docker-compose 本地调试」（docker compose up/run）准备，docker-compose.yml 会自动
#   读取同目录 .env 做变量插值。走 ci_pipeline.sh（蓝鲸流水线）时变量由流水线注入，不读取 .env。
#   两套路径变量名不同：compose 用 CI_CLAUDE_CONFIG_REPO_PATH / CI_CLAUDE_TARGET_COMMIT，
#   ci_pipeline 用 CI_TARGET_REPO_PATH / CI_TARGET_REPO_TYPE（见下方对应区块）。

# ===== 飞书通知（compose 与 ci_pipeline 共用）=====

# 飞书机器人 Webhook GUID（不含 URL 前缀）
# 示例: db06f82a-4dad-43f6-bbef-97503e0b953a
# 设为 none 则不发送飞书通知
CI_CLAUDE_FEISHU_ROBOT=none

# 飞书私聊通知凭证（独立的飞书应用，非群机器人）
# 在飞书开放平台创建应用，开通"以应用身份发送私聊消息"权限
# 留空则不发送私聊通知
CI_CLAUDE_FEISHU_DM_APP_ID=
CI_CLAUDE_FEISHU_DM_APP_SECRET=

# ===== Claude 执行控制（compose 与 ci_pipeline 共用）=====

# 流水线触发 Claude 需要执行的 skill（docker/skills/ 下的目录名）
# 默认 analyze-prompt = 原有的配表提交影响分析逻辑
CI_INVOKE_SKILL=analyze-prompt

# 1=entrypoint 在 Claude 执行完后兜底把输出发飞书（skill 自身不发通知时用，如 mail-check）
# analyze-prompt 自己发通知，保持 0 避免重复
CI_ENTRYPOINT_NOTIFY=0

# 脚本层监控通知接收邮箱（entrypoint.sh 直接发送，与 backend DMMonitorDecorator 区分）
# 留空则关闭脚本层监控
CI_CLAUDE_MONITOR_EMAIL=v-wangtengda@ztgame.com

# ===== docker-compose 本地调试路径变量（ci_pipeline 不使用）=====

# 指定 commit hash（不指定则分析 HEAD）
CI_CLAUDE_TARGET_COMMIT=

# 配表仓库路径（相对于 docker-compose.yml 的位置）
# ../../config = rain-qa-func 同级目录下的 config 文件夹
CI_CLAUDE_CONFIG_REPO_PATH=../../config

# ===== ci_pipeline.sh 路径必填变量（docker-compose 本地调试不需要）=====
# 走 ci_pipeline.sh 时必填；走 docker-compose 时由上方 CI_CLAUDE_CONFIG_REPO_PATH 挂载，不读这两个

# 目标仓库路径（绝对路径，指向含 .git 的完整仓库）
CI_TARGET_REPO_PATH=

# 目标仓库类型：config / frontend / backend
CI_TARGET_REPO_TYPE=config

# ===== CI 环境变量（本地测试留空，由流水线自动注入）=====
BK_CI_START_USER_NAME=
BK_CI_HOOK_BRANCH=
BK_CI_HOOK_REVISION=
