{
  "permissions": {
    "allow": [
      "Bash(git rebase *)",
      "Bash(mv .claude/settings.local.json /tmp/settings.local.json.bak)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-branch-safety.sh",
            "timeout": 3000
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "rain-qa-func",
    "thinking",
    "forgetful"
  ],
  "worktree": {
    "baseRef": "head"
  }
}
